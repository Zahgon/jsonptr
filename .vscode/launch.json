{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug tests (run mvn -Dmaven.surefire.debug test first)",
            "type": "java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        },
        {
            "name": "Debug test: JsonPtrTest.testGet (run mvn -Dmaven.surefire.debug -Dtest=JsonPtrTest#testGet test first)",
            "type": "java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        },
        {
            "name": "jsonptr parse",
            "type": "java",
            "request": "launch",
            "mainClass": "jsonptr.Main",
            "projectName": "jsonptr",
            "args": ["parse", "/a~1b/0"]
        },
        {
            "name": "jsonptr escape",
            "type": "java",
            "request": "launch",
            "mainClass": "jsonptr.Main",
            "projectName": "jsonptr",
            "args": ["escape", "a/b~c"]
        },
        {
            "name": "jsonptr unescape",
            "type": "java",
            "request": "launch",
            "mainClass": "jsonptr.Main",
            "projectName": "jsonptr",
            "args": ["unescape", "a~1b~0c"]
        }
    ]
